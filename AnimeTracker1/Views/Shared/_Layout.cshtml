<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AnimeTracker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AnimeTracker.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>
<body class="anime-theme">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark purple-navbar">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-play-circle-fill me-2"></i>AnimeTracker
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Anime" asp-action="Index">
                                <i class="bi bi-collection me-1"></i>My Anime
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check me-1"></i>Privacy
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <span>&copy; 2025 - AnimeTracker</span>
                    <span class="mx-2">|</span>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                </div>
                <div class="social-links">
                    <a href="#" class="social-icon"><i class="bi bi-twitter"></i></a>
                    <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                    <a href="#" class="social-icon"><i class="bi bi-discord"></i></a>
                </div>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    
    <style>
        /* Purple Theme Styles */
        .anime-theme {
            background-color: #120B29;
            color: #BBA9D9;
        }
        
        /* Navbar Styles */
        .purple-navbar {
            background: linear-gradient(135deg, #1E0E42 0%, #2D1151 100%);
            box-shadow: 0 2px 15px rgba(0,0,0,0.4);
            padding: 0.75rem 0;
            border: none;
            margin-bottom: 1.5rem;
        }
        
        .navbar-brand {
            color: #fff !important;
            font-weight: bold;
            letter-spacing: 0.5px;
            transition: all 0.3s ease;
        }
        
        .navbar-brand:hover {
            color: #F472B6 !important;
            transform: translateY(-2px);
        }
        
        .navbar-nav .nav-link {
            color: #BBA9D9 !important;
            font-weight: 500;
            padding: 0.5rem 1rem;
            margin: 0 0.2rem;
            transition: all 0.3s ease;
        }
        
        .navbar-nav .nav-link:hover, 
        .navbar-nav .nav-link.active {
            color: #fff !important;
            transform: translateY(-2px);
        }
        
        .navbar-nav .nav-link.active {
            position: relative;
        }
        
        .navbar-nav .nav-link.active:after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 1rem;
            right: 1rem;
            height: 2px;
            background: #F472B6;
            border-radius: 2px;
        }
        
        .navbar-toggler {
            border-color: rgba(109, 40, 217, 0.5);
        }
        
        /* Main Container Styles */
        .main-container {
            min-height: calc(100vh - 180px);
        }
        
        /* Footer Styles */
        .footer {
            background: linear-gradient(135deg, #1E0E42 0%, #2D1151 100%);
            border: none;
            padding: 1.5rem 0;
            color: #BBA9D9;
            margin-top: 2rem;
            box-shadow: 0 -2px 15px rgba(0,0,0,0.3);
        }
        
        .footer a {
            color: #BBA9D9;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        .footer a:hover {
            color: #fff;
            text-decoration: none;
        }
        
        .social-links {
            display: flex;
            gap: 15px;
        }
        
        .social-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            background-color: rgba(109, 40, 217, 0.3);
            border-radius: 50%;
            transition: all 0.3s ease;
        }
        
        .social-icon:hover {
            background-color: #F472B6;
            transform: translateY(-3px);
        }
        
        .social-icon i {
            font-size: 1.2rem;
            color: #fff;
        }
        
        /* Custom buttons */
        .btn-purple {
            background-color: #6D28D9;
            border: none;
            color: white;
            transition: all 0.3s ease;
        }
        
        .btn-purple:hover {
            background-color: #5B21B6;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(109, 40, 217, 0.4);
        }
        
        .btn-accent {
            background-color: #F472B6;
            border: none;
            color: white;
            transition: all 0.3s ease;
        }
        
        .btn-accent:hover {
            background-color: #E74694;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(244, 114, 182, 0.4);
        }
        
        /* Card styling */
        .card {
            background-color: #1A0B38;
            border: 1px solid rgba(109, 40, 217, 0.2);
            border-radius: 10px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }
        
        /* Links styling */
        a {
            color: #6D28D9;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        
        a:hover {
            color: #F472B6;
            text-decoration: none;
        }
    </style>
</body>
</html>