

// Views/Anime/Details.cshtml
@model AnimeTracker1.Models.Anime
@{
    ViewData["Title"] = "Anime Details";
}

<h1>Details</h1>

<div>
    <h4>@Model.Title</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>
        
        <dt class="col-sm-3">Studio</dt>
        <dd class="col-sm-9">@Model.Studio</dd>
        
        <dt class="col-sm-3">Episodes</dt>
        <dd class="col-sm-9">@Model.Episodes</dd>
        
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@Model.Status</dd>
        
        <dt class="col-sm-3">Episodes Watched</dt>
        <dd class="col-sm-9">@Model.EpisodesWatched</dd>
        
        <dt class="col-sm-3">Rating</dt>
        <dd class="col-sm-9">@(Model.Rating.HasValue ? $"{Model.Rating}/10" : "Not rated")</dd>
        
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>
